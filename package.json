{
  "name": "supertwinv13",
  "private": true,
  "version": "13.2.1",
  "type": "module",
  "workspaces": [
    "worker"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "worker": "npm run dev -w @supertwinv13/worker",
    "bundle:worker": "node scripts/bundle-worker.mjs",
    "stage:node": "node scripts/stage-node-sidecar.mjs",
    "stage:media": "node scripts/stage-media-tools.mjs",
    "build:app": "npm run build && npm run bundle:worker && npm run stage:node && npm run stage:media && npm run tauri build",
    "build:appbundle": "npm run build && npm run bundle:worker && npm run stage:node && npm run stage:media && npm run tauri build -- --bundles app",
    "eval": "tsx worker/src/evals/cli.ts",
    "test": "vitest run && npm run test:scripts",
    "test:scripts": "vitest run --config scripts/vitest.config.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.2.10",
    "@fontsource/instrument-serif": "^5.2.8",
    "qrcode.react": "^4.2.0"
  }
}
