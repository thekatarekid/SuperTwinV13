{
  "name": "herogotchi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turn your face into a cute superhero virtual pet (standalone web app).",
  "scripts": {
    "setup:models": "node scripts/fetch-models.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "node scripts/fetch-models.mjs && node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "node scripts/fetch-models.mjs && tsc -p tsconfig.json && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
