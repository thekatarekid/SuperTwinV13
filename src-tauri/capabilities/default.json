{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window. Grants the shell plugin so the worker sidecar can be spawned and managed.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "shell:allow-spawn",
    "shell:allow-kill",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "global-shortcut:default"
  ]
}
