# Copy to .env. Pick ONE way to generate heroes from your face:
#
#  A) FREE + LOCAL (Apple Silicon Mac, 16 GB RAM is enough):
#       npm run setup:local      # installs MFLUX + downloads FLUX.2 Klein 4B (~15 GB, once)
#     Nothing to put here — it's picked automatically once installed.
#  B) Pollinations key (free credits) or C) Gemini key (paid) below.
#
# With none of these, the app runs in demo mode (a drawn placeholder hero).

# Local tuning (optional)
# MFLUX_QUANTIZE=8        # 4 = less RAM, a bit lower quality
# MFLUX_LOW_RAM=1         # slower, but safer with other apps open
# MFLUX_STEPS=4
# MFLUX_MODEL=flux2-klein-4b

# Free option: sign up at https://enter.pollinations.ai, claim free Quest Pollen,
# create a SECRET key (sk_...). It stays on the server, never in the browser.
POLLINATIONS_API_KEY=
# POLLINATIONS_MODEL=google/gemini-3.1-flash-image

# Paid option: Google AI Studio key with billing enabled (~$0.07/image).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-image-preview

# Force a provider: local | pollinations | gemini | mock
# IMAGE_PROVIDER=

# Safety rails for billable generations (checked before every call).
MAX_GENERATIONS_PER_HOUR=20
MAX_GENERATIONS_PER_DAY=60
# PORT=8787
