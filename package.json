{
  "name": "supertwinv13",
  "private": true,
  "version": "13.12.3",
  "type": "module",
  "workspaces": [
    "worker"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "worker": "node scripts/dev-worker.mjs",
    "worker:live": "node scripts/dev-worker.mjs --live",
    "probe:chatgpt-oauth": "npm run probe:chatgpt-oauth -w @supertwinv13/worker --",
    "test:worker:live:claude": "npm run test:live:claude -w @supertwinv13/worker",
    "bundle:worker": "node scripts/bundle-worker.mjs",
    "stage:node": "node scripts/stage-node-sidecar.mjs",
    "stage:media": "node scripts/stage-media-tools.mjs",
    "build:app": "npm run build && npm run bundle:worker && npm run stage:node && npm run stage:media && npm run tauri build",
    "build:appbundle": "npm run build && npm run bundle:worker && npm run stage:node && npm run stage:media && npm run tauri build -- --bundles app",
    "eval": "tsx worker/src/evals/cli.ts",
    "purge:eval-data": "tsx worker/src/evals/purge-cli.ts",
    "test": "vitest run && npm run test:scripts",
    "test:scripts": "vitest run --config scripts/vitest.config.mjs",
    "test:security": "npm test -w @supertwinv13/worker -- --run src/security/secret-absence.test.ts src/providers/chatgpt-oauth/auth.test.ts src/providers/chatgpt-oauth/keychain.test.ts src/providers/chatgpt-oauth/native-keychain-verification.test.ts src/providers/chatgpt-oauth/dev-snapshot.test.ts src/server/settings-provider-routes.test.ts",
    "verify:native-keychain": "npm run verify:native-keychain -w @supertwinv13/worker --",
    "golden:chatgpt:login": "npm run golden:chatgpt:login -w @supertwinv13/worker --",
    "verify:release": "node scripts/verify-release.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.2.10",
    "@fontsource/instrument-serif": "^5.2.8",
    "qrcode.react": "^4.2.0"
  }
}
